{
  "name": "undokit",
  "version": "0.1.0",
  "description": "Wrap allowlisted CRM field updates in durable before/after receipts and provide human-approved, conflict-aware compensation.",
  "license": "MIT",
  "author": "Jeremy Knox",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "undokit": "dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "migrations",
    "templates",
    "docs/OPERATIONS.md",
    "docs/RUNBOOK.md",
    "docs/HUMAN-DRILL.md",
    "docs/ARCHITECTURE.md",
    "LICENSE",
    "README.md",
    "docs/KNOWN-LIMITATIONS.md",
    "docs/PROVIDER-DECISION.md",
    "docs/DEPENDENCY-LICENSES.md",
    "docs/DOD.md",
    "docs/PRD.md",
    "docs/qa/AC-MATRIX.md"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "bash scripts/verify-quality.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
