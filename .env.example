# Copy to .env and replace the placeholders. .env is git-ignored. These are sandbox-only credentials:
# generate random values, never reuse a real password.
UNDOKIT_SANDBOX_COUCHDB_USER=sandbox-admin
UNDOKIT_SANDBOX_COUCHDB_PASSWORD=<generate-a-random-value>
# Host port on 127.0.0.1 for the local provider sandbox
UNDOKIT_SANDBOX_COUCHDB_PORT=15984
